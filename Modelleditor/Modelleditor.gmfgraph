<?xml version="1.0" encoding="ISO-8859-1"?>
<gmfgraph:Canvas xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:gmfgraph="http://www.eclipse.org/gmf/2006/GraphicalDefinition">
  <figures
      name="Modellelemente">
    <descriptors
        name="Rectangulum">
      <actualFigure
          xsi:type="gmfgraph:RoundedRectangle"
          name="Rectangulum"/>
    </descriptors>
    <descriptors
        name="Labulum">
      <actualFigure
          xsi:type="gmfgraph:Label"
          name="Labulum"
          text=""/>
    </descriptors>
    <descriptors
        name="Connektium">
      <actualFigure
          xsi:type="gmfgraph:PolylineConnection"
          name="Connektium"/>
    </descriptors>
  </figures>
  <nodes
      name="SignalNode"
      figure="Rectangulum"
      resizeConstraint="NONE"/>
  <nodes
      name="GleisNode"
      figure="Rectangulum"
      resizeConstraint="NONE"/>
  <nodes
      name="WeicheNode"
      figure="Rectangulum"
      resizeConstraint="NONE"/>
  <nodes
      name="DkwNode"
      figure="Rectangulum"
      resizeConstraint="NONE"/>
  <nodes
      name="GleisabschnittNode"
      figure="Rectangulum"
      resizeConstraint="NONE"/>
  <nodes
      name="StreckeNode"
      figure="Rectangulum"
      resizeConstraint="NONE"/>
  <nodes
      name="ControllerNode"
      figure="Rectangulum"
      resizeConstraint="NONE"/>
  <nodes
      name="BahnhofNode"
      figure="Rectangulum"
      resizeConstraint="NONE"/>
  <connections
      name="ConnectionName"
      figure="Connektium"/>
  <compartments
      name="StreckeComp"
      figure="Rectangulum"/>
  <compartments
      name="BahnhofComp"
      figure="Rectangulum"/>
  <compartments
      name="AbschnittComp"
      figure="Rectangulum"/>
  <labels
      name="ElementName"
      figure="Labulum"
      resizeConstraint="SOUTH"
      elementIcon="false"/>
</gmfgraph:Canvas>
